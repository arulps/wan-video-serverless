{
  "template": {
    "name": "wan-video-serverless",
    "image": "ghcr.io/your-org/wan-video-serverless:latest",
    "containerDiskGb": 50,
    "env": {
      "HF_HOME": "/models",
      "HF_HUB_ENABLE_HF_TRANSFER": "1",
      "DEFAULT_TASK": "ti2v-5B",
      "LOG_LEVEL": "INFO",
      "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True"
    }
  },
  "endpoint": {
    "name": "wan-video-serverless",
    "gpuPool": "ADA_24",
    "gpuId": "NVIDIA GeForce RTX 4090",
    "gpuTypeIds": [
      "NVIDIA GeForce RTX 4090",
      "NVIDIA L40S"
    ],
    "gpuCount": 1,
    "workersMin": 0,
    "workersMax": 3,
    "idleTimeoutSec": 300,
    "executionTimeoutSec": 3600,
    "scaleBy": "delay",
    "scaleThreshold": 4,
    "flashBoot": true,
    "minCudaVersion": "12.8",
    "modelReference": "https://huggingface.co/Wan-AI/Wan2.2-TI2V-5B:main"
  },
  "s3": {
    "defaultOutputBucket": null
  }
}
